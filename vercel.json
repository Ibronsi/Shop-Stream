{
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shop-stream-pr44.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://shop-stream-pr44.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
