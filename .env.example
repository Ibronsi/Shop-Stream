# Shared
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DB_SSL=true
SESSION_SECRET=replace-with-a-long-random-secret

# Render API
NODE_ENV=production
PORT=10000
SERVE_STATIC=false
CORS_ORIGIN=https://your-shop.vercel.app
PUBLIC_API_URL=https://your-shop-api.onrender.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Vercel frontend
VITE_API_URL=https://your-shop-api.onrender.com
